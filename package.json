{
  "author": "Google's Web DevRel Team and Google's Aurora Team",
  "bugs": {
    "url": "https://github.com/GoogleChrome/workbox/issues"
  },
  "description": "Top-level scripts and dependencies for the workbox monorepo. Not meant to be published to npm.",
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@google-cloud/storage": "^5.20.5",
    "@octokit/rest": "^19.0.13",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-multi-entry": "^7.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/babel__core": "^7.20.5",
    "@types/babel__preset-env": "^7.10.0",
    "@types/common-tags": "^1.8.4",
    "@types/eslint": "^8.56.12",
    "@types/estree": "^1.0.8",
    "@types/fs-extra": "^9.0.13",
    "@types/lodash": "^4.17.24",
    "@types/node": "^20.19.37",
    "@types/stringify-object": "^3.3.1",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "acorn": "^8.16.0",
    "babel-plugin-transform-async-to-promises": "^0.8.18",
    "babylon": "^6.18.0",
    "body-parser": "^1.20.4",
    "bytes": "^3.1.2",
    "camelcase": "^6.3.0",
    "chai": "^4.5.0",
    "chai-as-promised": "^7.1.2",
    "chai-match-pattern": "^1.3.0",
    "chalk": "^4.1.2",
    "clear-module": "^4.1.2",
    "comlink": "^4.4.2",
    "common-tags": "^1.8.2",
    "coveralls": "^3.1.1",
    "del": "^5.1.0",
    "depcheck": "^1.4.7",
    "eslint": "^7.32.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-header": "^3.1.1",
    "eslint-plugin-jsdoc": "^30.7.13",
    "execa": "^4.1.0",
    "express": "^4.22.1",
    "fs-extra": "^9.1.0",
    "glob": "^11.1.0",
    "globby": "^11.1.0",
    "gulp": "^4.0.2",
    "gzip-size": "^5.1.1",
    "husky": "^7.0.4",
    "idb": "^7.1.1",
    "jsdoc": "^3.6.11",
    "jsdoc-baseline": "^0.1.5",
    "lerna": "^5.6.2",
    "lint-staged": "^11.2.6",
    "memory-fs": "^0.5.0",
    "minimist": "^1.2.8",
    "mocha": "^9.2.2",
    "module-alias": "^2.3.4",
    "nunjucks": "^3.2.4",
    "nyc": "^15.1.0",
    "prettier": "^2.8.8",
    "proxyquire": "^2.1.3",
    "require-dir": "^1.2.0",
    "rollup": "^4.59.0",
    "selenium-assistant": "^6.1.1",
    "semver": "^7.7.4",
    "serve-index": "^1.9.2",
    "service-worker-mock": "^1.12.0",
    "sinon": "^9.2.4",
    "tempy": "^0.7.1",
    "type-fest": "^3.13.1",
    "typescript": "^4.9.5",
    "typescript-json-schema": "^0.63.0",
    "upath": "^1.2.0",
    "worker-plugin": "^5.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "homepage": "https://github.com/GoogleChrome/workbox#readme",
  "license": "MIT",
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  },
  "name": "workbox",
  "nyc": {
    "exclude": [
      "packages/workbox-core/models/messages/messages.mjs"
    ],
    "extension": [
      ".mjs",
      ".js"
    ],
    "include": [
      "packages/**/*"
    ]
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GoogleChrome/workbox.git"
  },
  "scripts": {
    "build:all": "pnpm -r --filter './packages/*' build",
    "dev": "pnpx concurrently -c \"#b794f4,#61dafb,#d43008,#32a06f\" \"pnpm dev:core\" \"pnpm dev:background-sync\" \"pnpm dev:broadcast-update\" \"pnpm dev:build\" \"pnpm dev:cacheable-response\" \"pnpm dev:cli\" \"pnpm dev:expiration\" \"pnpm dev:google-analytics\" \"pnpm dev:navigation-preload\" \"pnpm dev:precaching\" \"pnpm dev:range-requests\" \"pnpm dev:recipes\" \"pnpm dev:routing\" \"pnpm dev:strategies\" --names=core,background-sync,broadcast-update,build,cacheable-response,cli,expiration,google-analytics,navigation-preload,precaching,range-requests,recipes,routing,strategies",
    "dev:core": "cd packages/workbox-core && pnpm run dev",
    "dev:background-sync": "cd packages/workbox-background-sync && pnpm run dev",
    "dev:broadcast-update": "cd packages/workbox-broadcast-update && pnpm run dev",
    "dev:build": "cd packages/workbox-build && pnpm run dev",
    "dev:cacheable-response": "cd packages/workbox-cacheable-response && pnpm run dev",
    "dev:cli": "cd packages/workbox-cli && pnpm run dev",
    "dev:expiration": "cd packages/workbox-expiration && pnpm run dev",
    "dev:google-analytics": "cd packages/workbox-google-analytics && pnpm run dev",
    "dev:navigation-preload": "cd packages/workbox-navigation-preload && pnpm run dev",
    "dev:precaching": "cd packages/workbox-precaching && pnpm run dev",
    "dev:range-requests": "cd packages/workbox-range-requests && pnpm run dev",
    "dev:recipes": "cd packages/workbox-recipes && pnpm run dev",
    "dev:routing": "cd packages/workbox-routing && pnpm run dev",
    "dev:strategies": "cd packages/workbox-strategies && pnpm run dev",
    "gulp": "gulp",
    "lint": "gulp lint",
    "lint-staged": "lint-staged",
    "prepare": "husky install",
    "prettier": "prettier --ignore-unknown --write .",
    "test_integration": "gulp test_integration",
    "test_node": "gulp test_node",
    "test_server": "gulp test_server",
    "version": "gulp build && git add -A packages"
  },
  "version": ""
}
