{
  "name": "workbox-build",
  "version": "7.4.0",
  "description": "A module that integrates into your build process, helping you generate a manifest of local files that workbox-sw should precache.",
  "keywords": [
    "workbox",
    "workboxjs",
    "service worker",
    "caching",
    "fetch requests",
    "offline",
    "file manifest"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "Google's Web DevRel Team and Google's Aurora Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/googlechrome/workbox.git"
  },
  "bugs": "https://github.com/GoogleChrome/workbox/issues",
  "homepage": "https://github.com/GoogleChrome/workbox",
  "workbox": {
    "packageType": "node_ts"
  },
  "files": [
    "dist",
    "types"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm clean && node ./build.js && tsc",
    "build:with-deps": "node ./build.js --with-deps",
    "clean": "rm -rf types && rm -rf dist",
    "dev": "pnpx concurrently -c \"#ffcf00,#3178c6\" \"pnpm dev:build\" \"pnpm dev:types\" --names build,types",
    "dev:build": "node ./build.js --watch",
    "dev:types": "tsc --watch --preserveWatchOutput"
  },
  "devDependencies": {
    "@types/node": "^20.14.8",
    "es-check": "^9.6.1",
    "esbuild": "^0.27.3",
    "esbuild-node-externals": "^1.20.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@apideck/better-ajv-errors": "^0.3.6",
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@babel/runtime": "^7.29.2",
    "@rollup/plugin-babel": "^7.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@trickfilm400/rollup-plugin-off-main-thread": "^3.0.0-pre1",
    "ajv": "^8.18.0",
    "common-tags": "^1.8.0",
    "fast-json-stable-stringify": "^2.1.0",
    "fs-extra": "^11.3.4",
    "glob": "^13.0.6",
    "lodash": "^4.17.20",
    "pretty-bytes": "^7.1.0",
    "rollup": "^4.53.3",
    "source-map": "^0.7.6",
    "stringify-object": "^6.0.0",
    "strip-comments": "^2.0.1",
    "tempy": "^3.2.0",
    "upath": "^2.0.0",
    "workbox-background-sync": "workspace:*",
    "workbox-broadcast-update": "workspace:*",
    "workbox-cacheable-response": "workspace:*",
    "workbox-core": "workspace:*",
    "workbox-expiration": "workspace:*",
    "workbox-google-analytics": "workspace:*",
    "workbox-navigation-preload": "workspace:*",
    "workbox-precaching": "workspace:*",
    "workbox-range-requests": "workspace:*",
    "workbox-recipes": "workspace:*",
    "workbox-routing": "workspace:*",
    "workbox-strategies": "workspace:*",
    "workbox-streams": "workspace:*",
    "workbox-sw": "workspace:*",
    "workbox-window": "workspace:*"
  }
}
